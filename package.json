    "cmdk": "^1.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dompurify": "3.4.17",
    "dotenv": "^16.4.5",
    "embla-carousel-react": "^8.3.0",
