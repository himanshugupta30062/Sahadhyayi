{
  "name": "sahadhyayi",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://www.sahadhyayi.com",
  "type": "module",
  "scripts": {
    "predev": "node scripts/optimize-book-expert-artwork.mjs && node scripts/prepare-performance-assets.mjs",
    "dev": "vite",
    "predev:vite": "node scripts/optimize-book-expert-artwork.mjs && node scripts/prepare-performance-assets.mjs",
    "dev:vite": "vite",
    "prebuild": "node scripts/prepare-performance-assets.mjs",
    "build": "node scripts/generateSitemap.js && node scripts/optimize-book-expert-artwork.mjs && vite build && node scripts/prerender-public-content.mjs && npm run build:server:utils && npm run check:cloudflare-routing",
    "build:server:utils": "node scripts/build-server-utils.mjs",
    "check:cloudflare-routing": "node scripts/check-cloudflare-routing-config.mjs",
    "size:initial": "node scripts/check-initial-js-size.mjs",
    "prebuild:dev": "node scripts/prepare-performance-assets.mjs && node scripts/optimize-book-expert-artwork.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "test": "vitest run",
    "test:book-expert": "node scripts/evaluate-book-expert.mjs",
    "rag:seed": "node scripts/seed-book-expert-rag.mjs",
    "test:book-expert:smoke": "node scripts/evaluate-book-expert.mjs --limit=10",
    "preview": "vite preview",
    "start:server": "node server.js",
    "generate:sitemap": "node scripts/generateSitemap.js",
    "prerender": "node scripts/prerender.js",
    "generate:licenses": "node scripts/generateLicenseList.js",
    "generate:sbom": "npm sbom --sbom-format=cyclonedx --sbom-type=application --output-file=sbom.json",
    "verify:licenses": "node scripts/verifyLicenses.js",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "Main application bundle",
      "path": "dist/assets/index-*.js",
      "limit": "240 KB"
    },
    {
      "name": "Total client assets",
      "path": "dist/assets/*.js",
      "limit": "760 KB"
    }
  ],
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
