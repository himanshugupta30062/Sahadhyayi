    "react-window": "^1.8.11",
    "recharts": "^2.12.7",
    "socket.io": "^4.8.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.43.1",
    "vaul": "^0.9.3",
    "web-vitals": "^5.1.0",
