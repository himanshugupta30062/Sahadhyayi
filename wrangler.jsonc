{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahadhyayi",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "previews": {},
  "routes": [
    {
      "pattern": "sahadhyayi.com/*",
      "zone_name": "sahadhyayi.com"
    },
    {
      "pattern": "www.sahadhyayi.com/*",
      "zone_name": "sahadhyayi.com"
    }
  ],
  "workers_dev": true
}
